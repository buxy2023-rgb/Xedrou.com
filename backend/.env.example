PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

BASE_STORAGE_BUCKET=uploads

# --- Supabase project settings ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# --- Enit AI: self-hosted/free-first layer ---
# Point this at Ollama, vLLM, llama.cpp server, or another OpenAI-compatible endpoint.
# Leave blank if no self-hosted model is running; Enit will use the configured paid providers/fallback.
XEDRUO_LOCAL_AI_URL=
XEDRUO_LOCAL_AI_KEY=
XEDRUO_LOCAL_AI_MODEL=local-model
XEDRUO_LOCAL_AI_TEMPERATURE=0.2

# --- Optional external AI providers ---
# External providers are fallbacks after the self-hosted layer and are never required for the free layer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
AI_MAX_OUTPUT_TOKENS=4000

# Outbound email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Audio transcription (optional)
TRANSCRIPTION_PROVIDER_API_KEY=
